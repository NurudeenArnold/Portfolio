rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // All reads/writes go through the Vercel API using the Firebase Admin
    // SDK, which bypasses these rules entirely. No client (web or app)
    // talks to Firestore directly, so both collections stay fully closed.
    match /contactMessages/{messageId} {
      allow read, write: if false;
    }

    match /deviceTokens/{tokenId} {
      allow read, write: if false;
    }

    match /rateLimits/{key} {
      allow read, write: if false;
    }
  }
}
