# Firebase Console -> Project settings -> Service accounts -> Generate new private key.
# Paste the entire downloaded JSON file's contents as a single-line value here.
FIREBASE_SERVICE_ACCOUNT_KEY=

# Shared secret the PortfolioMessages mobile app sends as a Bearer token to
# GET /api/messages. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MESSAGES_API_KEY=
